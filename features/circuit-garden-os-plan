#!/usr/bin/env bash
set -euo pipefail
mkdir -p "$HOME/Documents/circuit-garden-os-session-plans"
file="$HOME/Documents/circuit-garden-os-session-plans/plan-$(date +%Y%m%d-%H%M%S).md"
{
 printf '# circuit-garden-os session plan\n\n'
 printf 'Created: %s\n\n' "$(date -Is)"
 printf 'Purpose: electronics design\n\n## Prompts\n'
 printf '%s\n' '- What are you making?' '- What is the next creative milestone?' '- What source files, licenses, or export settings need review?'
 printf '\n## Notes\n'
} > "$file"
nano "$file"
printf 'Saved locally: %s\n' "$file"
